{
  "name": "obsidian-toggle-terminal",
  "version": "2.0.0",
  "description": "Toggle a docked terminal panel in Obsidian, backed by a real pty and xterm.js.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "pty": "npm install @lydell/node-pty",
    "test": "esbuild test/unit.test.ts --bundle --platform=node --format=esm --outfile=test/.unit.mjs --alias:obsidian=./test/obsidian-stub.ts --log-level=warning && node --test test/.unit.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/node": "^20.14.10",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.13.1",
    "typescript": "^5.5.3",
    "ws": "^8.18.0"
  }
}
